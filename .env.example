# Test settings for the DoctorOnCall test suite, read by config.py.
# Copy this file to .env and fill in the empty values. Never commit .env - it holds login credentials.

# URLs
DOC_HOME_URL=https://www.doconcall.com.my/
DOC_LOGIN_URL=https://auth.dev.doctoroncall.com.my/?redirectUri=https%3A%2F%2Fwww.doconcall.com.my%2Fmy-account%2F
DOC_MY_ACCOUNT_URL=https://www.doconcall.com.my/my-account/

# Login credentials (fill these in; logged-in tests are skipped while they are empty)
DOC_EMAIL=
DOC_PASSWORD=

# Coupon used by the small order fee tests (fill in a valid test coupon code)
DOC_COUPON_CODE=
# Fixed discount the coupon gives, in RM
DOC_COUPON_AMOUNT=
